DEBUG=False
SECRET_KEY=your_production_secret_key_here
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# JWT Configuration
JWT_SECRET_KEY=your-separate-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DELTA=86400

# OIDC SSO: register an active Confidential client with the same issuer below.
# Local and production provider registrations have different client credentials.
# Register the exact callback URL with the provider used by SSO_ISSUER.
# For local development: http://localhost:8000/api/auth/sso/callback
# For production: https://ikapi.szlg.info/api/auth/sso/callback
SSO_ISSUER=http://localhost:8002/o
SSO_CLIENT_ID=
# Leave empty for a Public client; set the registered secret for a Confidential client.
SSO_CLIENT_SECRET=
# Optional; must match the client's token endpoint auth method in SZLG+.
# Values: none, client_secret_basic (default with a secret), client_secret_post
# SSO_TOKEN_AUTH_METHOD=client_secret_basic
SSO_SCOPES=openid profile email groups
SSO_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback
SSO_FRONTEND_URL=http://localhost:3000/login

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=email@example.com
EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
DEFAULT_FROM_EMAIL=email@example.com

# OTP Configuration
OTP_EXPIRY_MINUTES=15
RESET_TOKEN_EXPIRY_MINUTES=10

# BKK API Configuration
BKK_TOKEN=your-bkk-api-token-here

# WebAuthn / Passkey Configuration
WEBAUTHN_RP_ID=igazolas.szlg.info
WEBAUTHN_RP_NAME=Igazoláskezelő
WEBAUTHN_ORIGINS=https://igazolas.szlg.info

# FTV External API Configuration
FTV_EXTERNAL_ACCESS_TOKEN=your-secure-ftv-token-here-change-in-production
